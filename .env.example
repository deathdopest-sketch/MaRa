# =============================================================================
# MaRa — room intelligence sniffer
# she watches. she knows. she never speaks.
# =============================================================================
# Copy to .env and fill your values. Never commit .env.
# Run: node mara.js (sniffer) or node main.js (full bot)
# =============================================================================

# ── Owner ─────────────────────────────────────────────────────────────────────
OWNER_ACCOUNT=freddysparks

# ── Platform (sniffer mode) ───────────────────────────────────────────────────
# Which platform to sniff: chatcommon | mumble | both | stumblechat
PLATFORM=stumblechat

# ── ChatCommon ────────────────────────────────────────────────────────────────
CHATCOMMON_USERNAME=your_chatcommon_username
CHATCOMMON_PASSWORD=your_chatcommon_password
CHATCOMMON_ROOMS=d_d,n_n

# ── StumbleChat (sniffer mode — attaches to YOUR running Chrome) ──────────────
# 1. run launch-chrome.bat (closes Chrome, reopens with debug port — login stays)
# 2. navigate to stumblechat.com and join your room(s)
# 3. node mara.js
CHROME_CDP_PORT=9222
# Leave blank to sniff all open StumbleChat tabs, or specify rooms:
# STUMBLECHAT_ROOMS=meatspace,slutboss

# ── MumbleChat (sniffer mode) ─────────────────────────────────────────────────
# MUMBLECHAT_BOT_KEY=mc_...
# MUMBLECHAT_SERVER_URL=https://mumblechat.online
# MUMBLECHAT_ROOMS=ddd

# ── Sniffer options ───────────────────────────────────────────────────────────
# MARA_DATA_DIR=./data        # where snapshots are saved (default: ./data)
# MARA_REFRESH_MS=2000        # dashboard refresh rate ms

# ── Full bot mode (node main.js) ──────────────────────────────────────────────
# ── Required ────────────────────────────────────────────────────────────────
MARA_CC_USERNAME=your_chatcommon_username
MARA_CC_PASSWORD=your_chatcommon_password

# ── Rooms ────────────────────────────────────────────────────────────────────
MARA_CC_ROOMS=d_d,n_n

# ── Identity ─────────────────────────────────────────────────────────────────
MARA_NICK=Mara
# Comma-separated ChatCommon handles that get full owner/flirt mode
MARA_OWNER_HANDLES=

# ── Ollama ────────────────────────────────────────────────────────────────────
MARA_OLLAMA_HOST=127.0.0.1:11434
MARA_MODEL=llama3
MARA_MODEL_FALLBACK=llama3

# ── Roleplay heat (1–5) ───────────────────────────────────────────────────────
MARA_PM_HEAT_LEVEL=4
MARA_PM_REALISM=true
MARA_HOT_MODEL=
MARA_HOT_MAX_RETRIES=2

# ── Data storage ──────────────────────────────────────────────────────────────
# Where Mara writes dossiers, associative memory, NNN weights.
# Defaults to ./data inside the Mara folder if not set.
# MARA_DATA_DIR=C:\Users\Death\Desktop\Mara\data

# ── ChatCommon proxy (optional) ───────────────────────────────────────────────
# CHATCOMMON_SOCKS_PROXY=socks5://127.0.0.1:1080

# ── Consciousness / training dataset dirs (all optional — missing dirs skip gracefully) ──
# CONSCIOUSNESS_DATA_DIR=C:\Users\Death\Desktop\DatasetsStorage\consciousness_scenario
# VITABIO_DIR=C:\Users\Death\Desktop\VITABIOWORKSHOP\datasets
# NOODO_DIR=C:\Users\Death\Desktop\NooDo\bot_data
# BUBU_DIR=C:\Users\Death\Desktop\BUBU\LuBu-s-boo-boo-main\examples
# ZOMB_CORPUS_DIR=C:\Users\Death\Desktop\zombv3.0\ZomB_Data
# DEBBIE_SFT_DIR=C:\Users\Death\Desktop\D_D\DebbieDeadclaude
# DEBBIE_TRAIN_DIR=C:\Users\Death\Desktop\DebbieDead
# BOTMAKER_DIR=C:\Users\Death\Desktop\botmaker\team_knowledge
# INSTRUCTION_DIR=C:\Users\Death\Desktop\DatasetsStorage\instruction

# ── Debug ─────────────────────────────────────────────────────────────────────
# DEBUG_MARA=1
