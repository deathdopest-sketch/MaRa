# =============================================================================
# MaRa — room intelligence sniffer
# she watches. she knows. she never speaks.
# =============================================================================
# Copy to .env and fill your values. Never commit .env.
# Run: node mara.js
# =============================================================================

# ── Owner ─────────────────────────────────────────────────────────────────────
OWNER_ACCOUNT=your_username
OWNER_PASS=your_password

# ── Platform ──────────────────────────────────────────────────────────────────
# Which platform to connect to: chatcommon | mumble | stumblechat | both
PLATFORM=stumblechat

# ── StumbleChat ───────────────────────────────────────────────────────────────
# Mara auto-launches Chrome, logs in with OWNER_ACCOUNT + OWNER_PASS,
# and hooks the rooms. Profile persists in data/chrome-profile.
STUMBLECHAT_ROOMS=your_room
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe  # auto-detected

# ── ChatCommon ────────────────────────────────────────────────────────────────
# CHATCOMMON_USERNAME=your_username
# CHATCOMMON_PASSWORD=your_password
# CHATCOMMON_ROOMS=d_d,n_n

# ── MumbleChat ────────────────────────────────────────────────────────────────
# MUMBLECHAT_BOT_KEY=mc_...
# MUMBLECHAT_SERVER_URL=https://mumblechat.online
# MUMBLECHAT_ROOMS=ddd

# ── Dashboard ─────────────────────────────────────────────────────────────────
# MARA_REFRESH_MS=2000       # dashboard redraw rate (ms)
# MARA_DATA_DIR=./data        # snapshot + memory storage dir

# ── Audio transcription (optional) ───────────────────────────────────────────
# Requires: npm install @xenova/transformers
# First run downloads ~75MB model to data/models/ — subsequent starts instant.
# WHISPER_MODEL=Xenova/whisper-base.en   # default; tiny.en is faster, lower quality

# ── Debug ─────────────────────────────────────────────────────────────────────
# DEBUG_MARA=1
